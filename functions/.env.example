# Deployment settings for the admin reporting functions.
# GA4 numeric property ID. An optional numeric stream ID filters the report.
ADMIN_GA4_PROPERTY_ID=
ADMIN_GA4_STREAM_ID=

# Fully qualified BigQuery table from the Android Crashlytics export.
# Use a single batch or realtime table.
ADMIN_CRASHLYTICS_TABLE=

# Non-secret Evibaby settings. Copy to functions/.env (ignored by Git).
EVIBABY_BASE_URL=https://api.deepseek.com
# API alias for DeepSeek-V4.1-Flash-1017 (see api-docs.deepseek.com/updates/).
EVIBABY_MODEL=deepseek-flash
# Emulator secret: functions/.secret.local, EVIBABY_API_KEY=your-key
# Cloud secret: firebase functions:secrets:set EVIBABY_API_KEY
