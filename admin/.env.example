# Copy this file to .env.local and use the Web app settings from Firebase Console.
# Local emulator mode needs no Firebase Web app registration.
VITE_FIREBASE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_ANALYTICS_ENABLED=false

# The dev:android-qa launcher enables local Android QA diagnostics.
VITE_ENABLE_DIAGNOSTICS=false
